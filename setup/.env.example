# =============================================================================
# linkedin-agent — modèle de variables d'environnement (COMMITTÉ)
# Copier : cp setup/.env.example setup/.env
# Puis renseigner les vraies valeurs dans setup/.env (ignoré par git)
# =============================================================================

# -----------------------------------------------------------------------------
# MongoDB (docker-compose)
# -----------------------------------------------------------------------------
MONGO_ROOT_USERNAME=devroot
MONGO_ROOT_PASSWORD=devpass
MONGO_DATABASE=linkedin_agent_db
MONGO_PORT=27017
MONGODB_URI=mongodb://devroot:devpass@localhost:27017/linkedin_agent_db?authSource=admin

# -----------------------------------------------------------------------------
# Auth admin bootstrap + JWT
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD="change-me-strong-password"
JWT_SECRET=replace-with-at-least-32-characters-secret

# -----------------------------------------------------------------------------
# Chiffrement AES-256 (Base64 de exactement 32 bytes)
# openssl rand -base64 32
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Email SMTP
# -----------------------------------------------------------------------------
MAIL_HOST=localhost
MAIL_USERNAME=
MAIL_PASSWORD=

# -----------------------------------------------------------------------------
# Clés LLM — optionnel (placeholders Spring AI). Runtime = /api/settings
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# URLs — production KOBE
# Frontend : https://agent-rev-front.kobecorporation.com
# Backend  : https://agent-rev-api.kobecorporation.com
# -----------------------------------------------------------------------------
FRONTEND_URL=https://agent-rev-front.kobecorporation.com
CORS_ALLOWED_ORIGINS=https://agent-rev-front.kobecorporation.com

# Callback OAuth LinkedIn = URL du BACKEND (déclarer dans LinkedIn Developer)
LINKEDIN_REDIRECT_URI=https://agent-rev-api.kobecorporation.com/api/linkedin/callback
LINKEDIN_OAUTH_SCOPES=w_organization_social r_organization_social

# LinkedIn credentials : via PUT /api/settings (DB), pas dans ce fichier
