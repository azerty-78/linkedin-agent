# =============================================================================
# linkedin-agent — template PROD (VPS)
# Copier vers ~/kobe-corporation/revolut-agent/api/.env (à côté de compose.prod.yaml)
#
# Admin bootstrap = BootstrapProperties.kt (PAS de ADMIN_* ici).
# Secrets : ne jamais committer ce fichier avec de vraies valeurs.
# =============================================================================

REVOLUT_AGENT_API_IMAGE=azerty78/revolut-agent-api:latest

MONGO_ROOT_USERNAME=CHANGE_ME_ROOT
MONGO_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MONGO_DATABASE=linkedin_agent_db

# URI interne Docker (service mongodb du compose)
MONGODB_URI=mongodb://CHANGE_ME_ROOT:CHANGE_ME_ROOT_PASSWORD@mongodb:27017/linkedin_agent_db?authSource=admin

JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET________
ENCRYPTION_KEY=CHANGE_ME_BASE64_OF_EXACTLY_32_BYTES____=

FRONTEND_URL=https://agent-rev-front.kobecorporation.com
CORS_ALLOWED_ORIGINS=https://agent-rev-front.kobecorporation.com
LINKEDIN_REDIRECT_URI=https://agent-rev-api.kobecorporation.com/api/linkedin/callback
LINKEDIN_OAUTH_SCOPES=openid profile email w_member_social
LINKEDIN_API_VERSION=202604

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
