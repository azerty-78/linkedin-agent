# =============================================================================
# linkedin-agent — variables PRODUCTION (NE PAS COMMITTER les vraies valeurs)
# Sur le VPS : ~/kobe-corporation/revolut-agent/api/.env
# Copier : cp setup/.env.prod.example …/api/.env  puis renseigner.
#
# Aligné avec :
#   - setup/compose.prod.yaml (injection env → conteneur api)
#   - src/main/resources/application-prod.properties (SPRING_PROFILES_ACTIVE=prod)
# =============================================================================

# -----------------------------------------------------------------------------
# Image API (renseigné aussi par la CI au deploy ; utile en manuel)
# -----------------------------------------------------------------------------
REVOLUT_AGENT_API_IMAGE=YOUR_DOCKERHUB_USER/revolut-agent-api:latest

# -----------------------------------------------------------------------------
# MongoDB (compose service « mongodb » + Spring)
# MONGO_* = init conteneur Mongo ; MONGODB_URI = Spring (hostname Docker interne)
# -----------------------------------------------------------------------------
MONGO_ROOT_USERNAME=change-me-mongo-user
MONGO_ROOT_PASSWORD=change-me-strong-mongo-password
MONGO_DATABASE=linkedin_agent_db
MONGODB_URI=mongodb://change-me-mongo-user:change-me-strong-mongo-password@mongodb:27017/linkedin_agent_db?authSource=admin

# -----------------------------------------------------------------------------
# Auth admin bootstrap + JWT
# JWT_SECRET : min. 32 caractères — obligatoire
# ADMIN_USERNAME : optionnel (sinon partie locale de ADMIN_EMAIL)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@kobecorporation.com
ADMIN_PASSWORD=change-me-strong-admin-password
ADMIN_USERNAME=admin
JWT_SECRET=replace-with-at-least-32-characters-secret-prod

# -----------------------------------------------------------------------------
# Chiffrement AES-256 — OBLIGATOIRE et STABLE en prod
# Base64 de exactement 32 bytes : openssl rand -base64 32
# Ne jamais changer après avoir chiffré des secrets en Mongo
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32

# -----------------------------------------------------------------------------
# Email SMTP (optionnel)
# -----------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# -----------------------------------------------------------------------------
# Placeholders Spring AI (clés runtime = /api/settings ou apps)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# URLs KOBE
# Front (nginx :4004) : https://agent-rev-front.kobecorporation.com
# API   (nginx :4005) : https://agent-rev-api.kobecorporation.com
# -----------------------------------------------------------------------------
FRONTEND_URL=https://agent-rev-front.kobecorporation.com
CORS_ALLOWED_ORIGINS=https://agent-rev-front.kobecorporation.com
LINKEDIN_REDIRECT_URI=https://agent-rev-api.kobecorporation.com/api/linkedin/callback
LINKEDIN_OAUTH_SCOPES=w_organization_social r_organization_social
# Optionnel — défaut application-prod = 202604
LINKEDIN_API_VERSION=202604
