# =============================================================================
# linkedin-agent — template LOCAL (copier vers setup/.env pour le dev)
# cp setup/.env.example setup/.env
#
# Admin bootstrap = BootstrapProperties.kt (PAS de ADMIN_* ici).
# Production VPS : ~/kobe-corporation/revolut-agent/api/.env
# =============================================================================

MONGO_ROOT_USERNAME=devroot
MONGO_ROOT_PASSWORD=devpass
MONGO_DATABASE=linkedin_agent_db
MONGO_PORT=27017
MONGODB_URI=mongodb://devroot:devpass@localhost:27017/linkedin_agent_db?authSource=admin

JWT_SECRET=dev-only-secret-change-me-min-32-characters-long
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=placeholder
MAIL_PASSWORD=placeholder

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LINKEDIN_REDIRECT_URI=http://localhost:8080/api/linkedin/callback
LINKEDIN_OAUTH_SCOPES=openid profile email w_member_social
LINKEDIN_API_VERSION=202604
